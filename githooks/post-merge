#!/usr/bin/env bash
# Warn-only post-merge: Graph-Refresh (alle Graphen + Embeddings) im Hintergrund.
# Detached, budgetiert, Staleness-gated — kehrt sofort zurueck, blockiert nie.
set -u
repo=$(git rev-parse --show-toplevel)
if [ -f "$HOME/scripts/graph-refresh-on-merge.sh" ]; then
  setsid nohup bash "$HOME/scripts/graph-refresh-on-merge.sh" "$repo" >>"$HOME/.cache/graph-refresh/hook.log" 2>&1 < /dev/null & disown || true
fi
exit 0
